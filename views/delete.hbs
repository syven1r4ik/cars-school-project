<h1>delete cars page</h1>
<hr>
<form method="post">
    <button formaction="/deleteAll" type="submit" onclick="return confirm('Czy na pewno?')">DELETE ALL CARS</button>
    <button formaction="/deleteSelected" type="submit" onclick="return confirm('Czy na pewno?')">DELETE SELECTED</button>
    <table>
        <tr>
            <th>_id</th>
            <th>model</th>
            <th>ubezpieczony</th>
            <th>benzyna</th>
            <th>uszkodzony</th>
            <th>naped4x4</th>
        </tr>
        {{#each cars}}
        <tr>
            <td>{{_id}}</td>
            <td>{{model}}</td>
            <td>{{ubezpieczony}}</td>
            <td>{{benzyna}}</td>
            <td>{{uszkodzony}}</td>
            <td>{{naped}}</td>
            <td><button formaction="/delete" type="submit" value="{{_id}}" name="id" onclick="return confirm('Czy na pewno?')">DELETE</button><input type="checkbox" name="delete" value="{{_id}}"></td>
        </tr>
        {{/each}}
    </table>
</form>